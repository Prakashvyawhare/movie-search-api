# Server Configuration
PORT=3000
NODE_ENV=development

# CORS Configuration
CLIENT_URL=http://localhost:5173

# JWT Secrets
JWT_SECRET=change_me_in_production_with_secure_key
JWT_REFRESH_SECRET=change_me_in_production_with_secure_key

# Token Expiration
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# Database Configuration (if using database)
DB_HOST=localhost
DB_PORT=27017
DB_NAME=task_manager
DB_USER=admin
DB_PASSWORD=

# Cookie Configuration
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict
COOKIE_MAX_AGE=900000

# Logging
LOG_LEVEL=info
